            <stringProp name="Argument.name">db_user</stringProp>
            <stringProp name="Argument.value">${__P(db_user,root)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">数据库连接用户, default: root</stringProp>
          </elementProp>
          <elementProp name="conn_pool_size" elementType="Argument">
            <stringProp name="Argument.name">conn_pool_size</stringProp>
            <stringProp name="Argument.value">${__P(conn_pool_size,15)}</stringProp>
