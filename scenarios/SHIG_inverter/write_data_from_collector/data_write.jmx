<?xml version="1.0" encoding="UTF-8"?>
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.5">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="Test Plan" enabled="true">
      <stringProp name="TestPlan.comments"></stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.tearDown_on_shutdown">true</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="[ConfigDebug] 预定义配置" enabled="false">
        <collectionProp name="Arguments.arguments">
          <elementProp name="db_url" elementType="Argument">
            <stringProp name="Argument.name">db_url</stringProp>
            <stringProp name="Argument.value">${__P(db_url,jdbc:postgresql://127.0.0.1:26257/defaultdb)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">数据库连接jdbc url, default: jdbc:postgresql://127.0.0.1:26257/defaultdb</stringProp>
          </elementProp>
          <elementProp name="db_user" elementType="Argument">
            <stringProp name="Argument.name">db_user</stringProp>
            <stringProp name="Argument.value">${__P(db_user,root)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">数据库连接用户, default: root</stringProp>
          </elementProp>
          <elementProp name="ts_db" elementType="Argument">
            <stringProp name="Argument.name">ts_db</stringProp>
            <stringProp name="Argument.value">${__P(ts_db,db_shig)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">创建时时序库名称, default: db_shig</stringProp>
          </elementProp>
          <elementProp name="write_throughput" elementType="Argument">
            <stringProp name="Argument.name">write_throughput</stringProp>
            <stringProp name="Argument.value">${__P(write_throughput,50000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">写入吞吐量/min, default: 50000</stringProp>
          </elementProp>
          <elementProp name="conn_pool_size" elementType="Argument">
            <stringProp name="Argument.name">conn_pool_size</stringProp>
            <stringProp name="Argument.value">${__P(conn_pool_size,20)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">线程池大小, default: 20</stringProp>
          </elementProp>
          <elementProp name="device_count_per_thread" elementType="Argument">
            <stringProp name="Argument.name">device_count_per_thread</stringProp>
            <stringProp name="Argument.value">${__P(device_count_per_thread,50)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">每个线程模拟设备数量, default: 50</stringProp>
          </elementProp>
          <elementProp name="csv_sample_data" elementType="Argument">
            <stringProp name="Argument.name">csv_sample_data</stringProp>
            <stringProp name="Argument.value">${__P(csv_sample_data,/data/data.csv)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">插入样本数据文件, default: C:\\Users\\hikari\\Desktop\\data.csv</stringProp>
          </elementProp>
          <elementProp name="data_ts_step" elementType="Argument">
            <stringProp name="Argument.name">data_ts_step</stringProp>
            <stringProp name="Argument.value">${__P(data_ts_step,1000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">生成数据时间戳间隔ms, default: 1000</stringProp>
          </elementProp>
          <elementProp name="write_limit_per_thread" elementType="Argument">
            <stringProp name="Argument.name">write_limit_per_thread</stringProp>
            <stringProp name="Argument.value">${__P(write_limit_per_thread,10000)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
            <stringProp name="Argument.desc">每个线程执行的数据写入次数, default: 10000</stringProp>
          </elementProp>
          <elementProp name="write_duration" elementType="Argument">
            <stringProp name="Argument.name">write_duration</stringProp>
            <stringProp name="Argument.value">${__P(write_duration,-1)}</stringProp>
            <stringProp name="Argument.desc">写入持续时间,ISO8601时间格式-1表示不限制,default: -1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="write_stop_at" elementType="Argument">
            <stringProp name="Argument.name">write_stop_at</stringProp>
            <stringProp name="Argument.value">${__P(write_stop_at,-1)}</stringProp>
            <stringProp name="Argument.desc">写入终止时间,时间格式参照&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;, -1表示不限制,default: -1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="device_no_start" elementType="Argument">
            <stringProp name="Argument.name">device_no_start</stringProp>
            <stringProp name="Argument.value">${__P(device_no_start,1)}</stringProp>
            <stringProp name="Argument.desc">起始设备编号,用于分布客户端创建,default: 1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="[ConfigPro] 读入配置" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="db_url" elementType="Argument">
