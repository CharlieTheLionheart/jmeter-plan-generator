      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="创建模板表: ${ts_db}.t_electmeter" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">CREATE TABLE ${ts_db}.t_electmeter (
  k_timestamp timestamp NOT NULL,
  elect_name varchar(63) NOT NULL,
  vol_a varchar(32) NOT NULL,
  cur_a varchar(32) NOT NULL,
  powerf_a varchar(32) NOT NULL,
  allenergy_a varchar(32) NOT NULL,
  pallenergy_a varchar(32) NOT NULL,
  rallenergy_a varchar(32) NOT NULL,
  allrenergy1_a varchar(32) NOT NULL,
  allrenergy2_a varchar(32) NOT NULL,
  powera_a varchar(32) NOT NULL,
  powerr_a varchar(32) NOT NULL,
  powerl_a varchar(32) NOT NULL,
  vol_b varchar(32) NOT NULL,
  cur_b varchar(32) NOT NULL,
  powerf_b varchar(32) NOT NULL,
  allenergy_b varchar(32) NOT NULL,
  pallenergy_b varchar(32) NOT NULL,
  rallenergy_b varchar(32) NOT NULL,
  allrenergy1_b varchar(32) NOT NULL,
  allrenergy2_b varchar(32) NOT NULL,
  powera_b varchar(32) NOT NULL,
  powerr_b varchar(32) NOT NULL,
  powerl_b varchar(32) NOT NULL,
  vol_c varchar(32) NOT NULL,
  cur_c varchar(32) NOT NULL,
  powerf_c varchar(32) NOT NULL,
  allenergy_c varchar(32) NOT NULL,
  pallenergy_c varchar(32) NOT NULL,
  rallenergy_c varchar(32) NOT NULL,
  allrenergy1_c varchar(32) NOT NULL,
  allrenergy2_c varchar(32) NOT NULL,
  powera_c varchar(32) NOT NULL,
  powerr_c varchar(32) NOT NULL,
  powerl_c varchar(32) NOT NULL,
  vol_ab varchar(32) NOT NULL,
  vol_bc varchar(32) NOT NULL,
  vol_ca varchar(32) NOT NULL,
  infre varchar(32) NOT NULL,
  powerf varchar(32) NOT NULL,
  allpower varchar(32) NOT NULL,
  pallpower varchar(32) NOT NULL,
  rallpower varchar(32) NOT NULL,
  powerr varchar(32) NOT NULL,
  powerl varchar(32) NOT NULL,
  allrenergy1 varchar(32) NOT NULL,
  allrenergy2 varchar(32) NOT NULL
) ATTRIBUTES (machine_code varchar(64));</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
