      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="线程对象初始化" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.*
import java.io.*
import org.apache.jmeter.protocol.jdbc.config.DataSourceElement
import java.text.SimpleDateFormat

vars.putObject(&quot;dateFormater&quot;, new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;))
vars.putObject(&quot;stmt&quot;, DataSourceElement.getConnection(&quot;default_pool&quot;).createStatement())
vars.putObject(&quot;last_ts&quot;, System.currentTimeMillis())
vars.putObject(&quot;counter&quot;, 1)
vars.putObject(&quot;sample_data&quot;, new File(vars.get(&quot;csv_sample_data&quot;)).readLines())</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="吞吐量控制" enabled="true">
          <stringProp name="throughput">${write_throughput}</stringProp>
          <intProp name="calcMode">0</intProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="循环写入" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <stringProp name="LoopController.loops">${device_count_per_thread}</stringProp>
        </LoopController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="写入表: ${ts_db}.electmeter_${__threadNum}_${counter}" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.sql.*
import java.io.*
def next_ts = vars.getObject(&quot;last_ts&quot;)
def builder = new StringBuilder()

builder.append(&quot;insert into ${vars.get(&quot;ts_db&quot;)}.electmeter_${__threadNum}_${vars.getObject(&quot;counter&quot;)} values &quot;)
for(String line in vars.getObject(&quot;sample_data&quot;)) {
  builder.append(&quot;(${next_ts},${line}),&quot;)
  next_ts += Integer.parseInt(vars.get(&quot;data_ts_step&quot;))
}
builder.setCharAt(builder.length() - 1, &apos;;&apos; as char)
log.info(builder.toString())
try{
  def execCode = vars.getObject(&quot;stmt&quot;).executeUpdate(builder.toString())
  if (1 &gt; execCode) {
     SampleResult.setResponseData(&quot;Insert error: ${execCode}&quot;)
     SampleResult.setSuccessful(false)
  }
} catch (Exception ex) {
     SampleResult.setResponseData(&quot;Insert error: ${ex.getMessage()}&quot;)
     SampleResult.setSuccessful(false)
}
vars.putObject(&quot;last_ts&quot;, next_ts)
vars.putObject(&quot;counter&quot;, vars.getObject(&quot;counter&quot;) + 1)
SampleResult.setResponseData(&quot;Execute SQL: ${builder.toString()}&quot;)
SampleResult.setSuccessful(true)</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
