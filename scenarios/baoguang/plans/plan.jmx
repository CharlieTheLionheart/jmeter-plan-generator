        <hashTree>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0)querypage" enabled="true">
            <stringProp name="dataSource">default_pool</stringProp>
            <stringProp name="queryType">Prepared Select Statement</stringProp>
            <stringProp name="query">select last(k_timestamp) as ts, last(voltage) as vol, last(current) as cur, last(temperature) as temp, number from db_baoguang.single_battery where ${begin_number} &lt; number and number &lt;= ${end_number} group by number order by number asc;</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable">ts,vol,cur,temp,number</stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">int devicePerThread = 10 * 10000;

int threadNum = Integer.parseInt(&quot;${__threadNum}&quot;);

Integer roundIdx = vars.get(&quot;round_idx_${__threadNum}&quot;) as Integer;
if (roundIdx == null) {
	roundIdx = 1;
}

int numberBegin = (threadNum - 1) * devicePerThread + 1000 * (roundIdx - 1);
int numberEnd = (threadNum - 1) * devicePerThread + 1000 * roundIdx;

roundIdx++;
vars.putObject(&quot;round_idx_${__threadNum}&quot;, roundIdx);
vars.putObject(&quot;begin_number&quot;, numberBegin);
vars.putObject(&quot;end_number&quot;, numberEnd);</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
      </hashTree>
      <ResultCollector guiclass="ViewResultsFullVisualizer" testclass="ResultCollector" testname="结果树" enabled="true">
        <boolProp name="ResultCollector.error_logging">false</boolProp>
        <objProp>
          <name>saveConfig</name>
          <value class="SampleSaveConfiguration">
            <time>true</time>
            <latency>true</latency>
            <timestamp>true</timestamp>
