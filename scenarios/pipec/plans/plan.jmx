            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: type_1_thread_${__threadNum}" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">import com.kaiwudb.svt.utils.ctx.DataSeedCtx
import com.kaiwudb.svt.model.RowData
import com.kaiwudb.svt.model.CommaSplitTextData

List&lt;RowData&gt; pointList = DataSeedCtx.getRowDataList(&quot;${vars.get(&quot;db_name&quot;)}.t_point&quot;)
List&lt;RowData&gt; tagList = DataSeedCtx.getExecByGroupTag(&quot;${vars.get(&quot;db_name&quot;)}.t_point&quot;, &quot;1&quot;, &quot;${__threadNum}&quot;)

StringBuilder pointBuilder = new StringBuilder();
pointBuilder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_point values &quot;)
long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;));
long nextTs = 0;
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  nextTs = vars.getObject(&quot;last_ts&quot;);
} else {
  nextTs = System.currentTimeMillis();
}

int insertBatchSize = Integer.parseInt(vars.get(&quot;insert_batch_size&quot;))
//log.info(&quot;insertBatchSize=&quot;+insertBatchSize)

int lastFromIdx = Integer.parseInt(vars.get(&quot;last_from_idx&quot;))
int toIdx = lastFromIdx + insertBatchSize
for(int i = lastFromIdx; i &lt; toIdx; i++) {
    String colVal = ((CommaSplitTextData) pointList.get(i % pointList.size())).getDataLine()
    String tags = ((CommaSplitTextData) tagList.get(i % tagList.size())).getDataLine()
    pointBuilder.append(&quot;(${nextTs},&quot;).append(colVal).append(&quot;,&quot;).append(tags).append(&quot;),&quot;);
    nextTs += dataTsStep
}

pointBuilder.setCharAt(pointBuilder.length() - 1, &apos;;&apos; as char)
//log.warn(pointBuilder.toString());

vars.put(&quot;pointSnSql&quot;, pointBuilder.toString());
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  vars.putObject(&quot;last_ts&quot;, nextTs);
}
vars.put(&quot;last_from_idx&quot;, toIdx + &quot;&quot;);</stringProp>
