        </LoopController>
        <hashTree>
          <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="${pointSnSql}" enabled="false">
            <boolProp name="displayJMeterProperties">false</boolProp>
            <boolProp name="displayJMeterVariables">true</boolProp>
            <boolProp name="displaySystemProperties">false</boolProp>
          </DebugSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: ${db_name}.t_work_area_${__threadNum}" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// 在另一个线程组中获取属性
String pointSnListStr = props.getProperty(&quot;pointSnList&quot;);
List&lt;String&gt; pointSnList = Arrays.asList(pointSnListStr.substring(1, pointSnListStr.length()-1).replaceAll(&quot; &quot;, &quot;&quot;).split(&quot;,&quot;));
int writeLines = Integer.parseInt(vars.get(&quot;write_lines&quot;));
Random random_gen = vars.getObject(&quot;random_generator&quot;);

StringBuilder pointSnBuilder = new StringBuilder();
pointSnBuilder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_work_area values &quot;)
long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;));
long nextTs = 0;
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  nextTs = vars.getObject(&quot;last_ts&quot;);
} else {
  nextTs = System.currentTimeMillis();
}

int pointSnListIdx = 0;
int pointSnListSize = pointSnList.size();
for(int lineIdx = 0; lineIdx &lt; writeLines; lineIdx++) {
  pointSnListIdx = lineIdx;
  if (pointSnListIdx &gt;= pointSnListSize) {
    pointSnListIdx = pointSnListIdx % pointSnListSize;
  }
  pointSnBuilder.append(&quot;(${nextTs},${random_gen.nextDouble()},${random_gen.nextInt(18)},&apos;${pointSnList.get(pointSnListIdx)}&apos;,&apos;${work_area_sn}&apos;),&quot;);
  nextTs += dataTsStep;
  pointSnListIdx++;
}
pointSnBuilder.setCharAt(pointSnBuilder.length() - 1, &apos;;&apos; as char)
//log.info(pointSnBuilder.toString());

vars.put(&quot;pointSnSql&quot;, pointSnBuilder.toString());
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  vars.putObject(&quot;last_ts&quot;, nextTs);
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0)写入数据: " enabled="true">
            <stringProp name="dataSource">default_pool</stringProp>
            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">${pointSnSql}</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout">60</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: ${db_name}.t_work_area_${__threadNum}" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">// 在另一个线程组中获取属性
String pointSnListStr = props.getProperty(&quot;pointSnList&quot;);
List&lt;String&gt; pointSnList = Arrays.asList(pointSnListStr.substring(1, pointSnListStr.length()-1).replaceAll(&quot; &quot;, &quot;&quot;).split(&quot;,&quot;));
int writeLines = Integer.parseInt(vars.get(&quot;write_lines&quot;));
Random random_gen = vars.getObject(&quot;random_generator&quot;);

StringBuilder pointSnBuilder = new StringBuilder();
pointSnBuilder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_work_area values &quot;)
long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;));
long nextTs = 0;
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  nextTs = vars.getObject(&quot;last_ts&quot;);
} else {
  nextTs = System.currentTimeMillis();
}

int pointSnListIdx = 0;
int pointSnListSize = pointSnList.size();
for(int lineIdx = 0; lineIdx &lt; writeLines; lineIdx++) {
  pointSnListIdx = lineIdx;
  if (pointSnListIdx &gt;= pointSnListSize) {
    pointSnListIdx = pointSnListIdx % pointSnListSize;
  }
  pointSnBuilder.append(&quot;(${nextTs},${random_gen.nextDouble()},${random_gen.nextInt(18)},&apos;${pointSnList.get(pointSnListIdx)}&apos;,&apos;${work_area_sn}&apos;),&quot;);
  nextTs += dataTsStep;
  pointSnListIdx++;
}
pointSnBuilder.setCharAt(pointSnBuilder.length() - 1, &apos;;&apos; as char)
//log.info(pointSnBuilder.toString());

vars.put(&quot;pointSnSql&quot;, pointSnBuilder.toString());
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  vars.putObject(&quot;last_ts&quot;, nextTs);
}</stringProp>
