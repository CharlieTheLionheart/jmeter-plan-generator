      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)加载点号" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def point_sn_reader = new RandomAccessFile(vars.get(&quot;point_sn_data&quot;), &quot;r&quot;)
String line;
List pointSnList = new ArrayList();
do {
  line = point_sn_reader.readLine();
  if (line != null) {
    pointSnList.add(line);
  }
} while (line != null);
props.put(&quot;pointSnList&quot;, pointSnList.toString())
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
      </hashTree>
