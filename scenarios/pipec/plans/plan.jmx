      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)线程对象初始化" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">vars.putObject(&quot;last_ts&quot;, System.currentTimeMillis())
SampleResult.setIgnore()

log.debug(vars.get(&quot;point_sn_data_dir&quot;) + &quot;0_&quot; + &quot;${__threadNum}.csv&quot;)
def point_sn_reader = new RandomAccessFile(vars.get(&quot;point_sn_data_dir&quot;) + &quot;0_&quot; + &quot;${__threadNum}.csv&quot;, &quot;r&quot;)

String line;
List pointSnList = new ArrayList();
do {
    line = point_sn_reader.readLine();
    if (line != null) {
        pointSnList.add(line);
    }
} while (line != null);

vars.putObject(&quot;vars_pointSnList&quot;, pointSnList)</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="吞吐量控制" enabled="true">
          <stringProp name="throughput">${__BeanShell(${write_throughput}  / ${insert_batch_size},)} </stringProp>
          <intProp name="calcMode">0</intProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="(2.0.0)循环写入type0" enabled="true">
          <boolProp name="LoopController.continue_forever">true</boolProp>
          <intProp name="LoopController.loops">-1</intProp>
        </LoopController>
        <hashTree>
          <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="${pointSnSql}" enabled="false">
            <boolProp name="displayJMeterProperties">false</boolProp>
            <boolProp name="displayJMeterVariables">true</boolProp>
            <boolProp name="displaySystemProperties">false</boolProp>
          </DebugSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: ${db_name}.t_work_area_${__threadNum}" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">def point_sn_reader = new RandomAccessFile(vars.get(&quot;point_sn_data_dir&quot;) + &quot;${__threadNum}.csv&quot;, &quot;r&quot;)
String line;
List pointSnList = new ArrayList();
do {
    line = point_sn_reader.readLine();
    if (line != null) {
        pointSnList.add(line);
    }
} while (line != null);

StringBuilder pointSnBuilder = new StringBuilder();
pointSnBuilder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_point values &quot;)
long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;));
long nextTs = 0;
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  nextTs = vars.getObject(&quot;last_ts&quot;);
} else {
  nextTs = System.currentTimeMillis();
}

for(int pointSnListIdx = 1; pointSnListIdx &lt; pointSnList.size();pointSnListIdx++) {
  pointSnBuilder.append(&quot;(${nextTs}, ${pointSnList.get(pointSnListIdx)}),&quot;);
  nextTs += dataTsStep;
}
pointSnBuilder.setCharAt(pointSnBuilder.length() - 1, &apos;;&apos; as char)
//log.info(pointSnBuilder.toString());

vars.put(&quot;pointSnSql&quot;, pointSnBuilder.toString());
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  vars.putObject(&quot;last_ts&quot;, nextTs);
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0)写入数据type0" enabled="true">
            <stringProp name="dataSource">default_pool</stringProp>
            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">${pointSnSql}</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout">60</stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: ${__threadNum}" enabled="true">
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="script">List pointSnList = new ArrayList();
pointSnList = vars.getObject(&quot;vars_pointSnList&quot;);

StringBuilder pointSnBuilder = new StringBuilder();
pointSnBuilder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_point values &quot;)
long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;));
long nextTs = 0;
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  nextTs = vars.getObject(&quot;last_ts&quot;);
} else {
  nextTs = System.currentTimeMillis();
}

def insertBatchSize = Long.parseLong(vars.get(&quot;insert_batch_size&quot;))
for(int i = 0; i &lt; insertBatchSize; i++) {
  for(int pointSnListIdx = 1; pointSnListIdx &lt; pointSnList.size();pointSnListIdx++) {
    pointSnBuilder.append(&quot;(${nextTs}, ${pointSnList.get(pointSnListIdx)}),&quot;);
  }
  nextTs += dataTsStep
}

pointSnBuilder.setCharAt(pointSnBuilder.length() - 1, &apos;;&apos; as char)
//log.info(pointSnBuilder.toString());

vars.put(&quot;pointSnSql&quot;, pointSnBuilder.toString());
if (Integer.valueOf(&quot;${data_ts_step}&quot;)&gt;5) {
  vars.putObject(&quot;last_ts&quot;, nextTs);
}</stringProp>
              <stringProp name="scriptLanguage">groovy</stringProp>
            </JSR223PreProcessor>
