      <hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0)创建管网测点表: ${db_name}.t_point" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">CREATE TABLE ${db_name}.t_point (
  k_timestamp timestamp NOT NULL,
  measure_value double
 ) ATTRIBUTES (
  point_sn varchar(64) NOT NULL,
  work_area_sn varchar(16),
  sub_com_sn varchar(32),
  station_sn varchar(16),
  pipeline_sn varchar(16),
  measure_type smallint)
  PRIMARY TAGS(point_sn) activetime 3h;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
