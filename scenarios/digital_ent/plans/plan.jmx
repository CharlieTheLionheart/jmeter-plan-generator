          <stringProp name="query">select ts as timestamp, * from ${db_name}.stbl_event where ts &gt;= ? and ts &lt;= ? and identifier = ? order by ts desc limit ? offset ?;</stringProp>
          <stringProp name="queryArguments">${q_ts_begin},${q_ts_end},${rand_id},${rand_limit},${rand_offset}</stringProp>
          <stringProp name="queryArgumentsTypes">timestamp,timestamp,varchar,integer,integer</stringProp>
