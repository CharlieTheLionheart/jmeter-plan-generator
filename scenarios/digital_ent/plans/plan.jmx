        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="SQL3: time_bucket of pt100_dm" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Prepared Select Statement</stringProp>
          <stringProp name="query">select time_bucket(ts, &apos;10ms&apos;) as bucket_ts, avg(${rand_mp}) as avg_mp from ${db_name}.${rand_table_name} where ts &gt;= ? and ts &lt;= ? and device = ? group by bucket_ts;</stringProp>
          <stringProp name="queryArguments">${q_ts_begin},${q_ts_end},${rand_device}</stringProp>
          <stringProp name="queryArgumentsTypes">timestamp,timestamp,varchar</stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout"></stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ThreadLocalRandom

vars.put(&quot;rand_mp&quot;, &quot;mp&quot; + ThreadLocalRandom.current().nextInt(1, 34))
int dupTableTotalAmount = Integer.parseInt(vars.getObject(&quot;dup_table_total_amount&quot;))
String randTableNameSuffixVal = ThreadLocalRandom.current().nextInt(1, dupTableTotalAmount + 1) + &quot;&quot;
StringBuilder suffixBuilder = new StringBuilder(randTableNameSuffixVal)
int dupTableSuffixDigits = Integer.parseInt(vars.get(&quot;dup_table_suffix_digits&quot;))
int zerosToPad = dupTableSuffixDigits - randTableNameSuffixVal.length();
for (int i = 0; i &lt; zerosToPad; i++) {
  suffixBuilder.insert(0, &quot;0&quot;)
}
vars.put(&quot;rand_table_name&quot;, &quot;pt100_dm_&quot; + suffixBuilder)
vars.putObject(&quot;q_ts_begin&quot;, &quot;${__timeShift(yyyy-MM-dd HH:mm:ss.SSS,,-PT1H,,)}&quot;)
vars.putObject(&quot;q_ts_end&quot;, &quot;${__time(yyyy-MM-dd HH:mm:ss.SSS,)}&quot;)
vars.putObject(&quot;rand_device&quot;, &quot;device&quot; + ThreadLocalRandom.current().nextInt(1, 1001))</stringProp>
          </JSR223PreProcessor>
