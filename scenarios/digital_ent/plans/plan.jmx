            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ThreadLocalRandom

vars.putObject(&quot;q_ts_begin&quot;, &quot;${__timeShift(yyyy-MM-dd HH:mm:ss.SSS,,-PT1H,,)}&quot;)
vars.putObject(&quot;q_ts_end&quot;, &quot;${__time(yyyy-MM-dd HH:mm:ss.SSS,)}&quot;)
vars.putObject(&quot;rand_id&quot;, &quot;id&quot; + ThreadLocalRandom.current().nextInt(1, 21))
def rand_limit_arr = [5, 15, 20, 25, 50, 100]
vars.putObject(&quot;rand_limit&quot;, rand_limit_arr[ThreadLocalRandom.current().nextInt(0, 6)])
def rand_offset_arr = [1, 1000, 100000, 10000000]
vars.putObject(&quot;rand_offset&quot;, rand_offset_arr[ThreadLocalRandom.current().nextInt(0, 4)])
</stringProp>
          </JSR223PreProcessor>
