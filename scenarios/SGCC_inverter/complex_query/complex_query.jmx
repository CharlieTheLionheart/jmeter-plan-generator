          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="create device ${deviceNamePrefix}${device_no}" enabled="true">
            <stringProp name="dataSource">kwdb-${db_user}</stringProp>
            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">create device ${tenantName}.${portalName}.${deviceNamePrefix}${device_no}(
  id varchar(128) groupname ${endpointGroupName},
  is_real_time int4 groupname ${endpointGroupName},
  rssi_level int4 groupname ${endpointGroupName},
  rssi int4 groupname ${endpointGroupName},
  date_create_time timestamp groupname ${endpointGroupName},
  pac float4 groupname ${endpointGroupName},
  e_today float4 groupname ${endpointGroupName},
  e_month float4 groupname ${endpointGroupName},
  e_year float4 groupname ${endpointGroupName},
  e_total float4 groupname ${endpointGroupName},
  inverter_temp float4 groupname ${endpointGroupName},
  inverter_state varchar(128) groupname ${endpointGroupName},
  alarm_cn nvarchar(128) groupname ${endpointGroupName},
  alarm_en varchar(128) groupname ${endpointGroupName},
  fac int4 groupname ${endpointGroupName},
  pv varchar(128) groupname ${endpointGroupName},
  ac varchar(128) groupname ${endpointGroupName},
  time_str varchar(128) groupname ${endpointGroupName},
  inverter_sn varchar(128) groupname ${endpointGroupName},
  sn varchar(128) groupname ${endpointGroupName},
  device_brand varchar(128) groupname ${endpointGroupName},
);</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
