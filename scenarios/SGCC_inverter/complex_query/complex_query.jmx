        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>
      <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="pipe params" enabled="true">
        <stringProp name="delimiter">|</stringProp>
        <stringProp name="fileEncoding">UTF-8</stringProp>
        <stringProp name="filename">/root/bin/scenarios/SGCC_inverter/pipeline_params.csv</stringProp>
        <boolProp name="ignoreFirstLine">true</boolProp>
        <boolProp name="quotedData">true</boolProp>
        <boolProp name="recycle">true</boolProp>
        <stringProp name="shareMode">shareMode.all</stringProp>
        <boolProp name="stopThread">false</boolProp>
        <stringProp name="variableNames">url,write_loops,batch_size,read_loops,range_begin,range_end,interval,write_times_per_minute,read_times_per_minute</stringProp>
      </CSVDataSet>
      <hashTree/>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="global params" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="theme" elementType="Argument">
            <stringProp name="Argument.name">theme</stringProp>
            <stringProp name="Argument.value">SGCC_inverter</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="deviceNamePrefix" elementType="Argument">
            <stringProp name="Argument.name">deviceNamePrefix</stringProp>
            <stringProp name="Argument.value">inverter</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="endpointGroupName" elementType="Argument">
            <stringProp name="Argument.name">endpointGroupName</stringProp>
            <stringProp name="Argument.value">inverter_g1</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="device_count" elementType="Argument">
            <stringProp name="Argument.name">device_count</stringProp>
            <stringProp name="Argument.value">${__P(device_count_p,5)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="db_url" elementType="Argument">
            <stringProp name="Argument.name">db_url</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="db_user" elementType="Argument">
            <stringProp name="Argument.name">db_user</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="db_passwd" elementType="Argument">
            <stringProp name="Argument.name">db_passwd</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="db_options" elementType="Argument">
            <stringProp name="Argument.name">db_options</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="db_conn_poll_count" elementType="Argument">
            <stringProp name="Argument.name">db_conn_poll_count</stringProp>
            <stringProp name="Argument.value"></stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
      </Arguments>
      <hashTree/>
      <Arguments guiclass="ArgumentsPanel" testclass="Arguments" testname="day params" enabled="true">
        <collectionProp name="Arguments.arguments">
          <elementProp name="yesterday" elementType="Argument">
            <stringProp name="Argument.name">yesterday</stringProp>
            <stringProp name="Argument.value">${__timeShift(yyyy-MM-dd,,P-1D,,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="today" elementType="Argument">
            <stringProp name="Argument.name">today</stringProp>
            <stringProp name="Argument.value">${__time(yyyy-MM-dd,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
          <elementProp name="tomorrow" elementType="Argument">
            <stringProp name="Argument.name">tomorrow</stringProp>
            <stringProp name="Argument.value">${__timeShift(yyyy-MM-dd,,P1D,,)}</stringProp>
            <stringProp name="Argument.metadata">=</stringProp>
          </elementProp>
        </collectionProp>
