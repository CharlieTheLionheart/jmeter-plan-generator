          <stringProp name="script">Double readTimesPerMinute = Double.valueOf(vars.get(&quot;read_times_per_minute&quot;));
vars.put(&quot;read_throughput&quot;, String.valueOf(readTimesPerMinute*10));</stringProp>
        </BeanShellPreProcessor>
