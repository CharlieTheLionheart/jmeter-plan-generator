      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="全局对象初始化" enabled="true">
          <stringProp name="scriptLanguage">java</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.text.SimpleDateFormat;
vars.putObject(&quot;dateFormater&quot;, new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss&quot;));</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="数据加载" enabled="true">
          <stringProp name="scriptLanguage">java</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.*;
import java.io.*;
import org.apache.jmeter.protocol.jdbc.config.DataSourceElement;

Connection conn = DataSourceElement.getConnection(&quot;default_pool&quot;);
PreparedStatement preparedStmts = conn.prepareStatement(&quot;insert into &quot; + vars.get(&quot;ts_db&quot;) + &quot;.electmeter_&quot; + ${__threadNum} + &quot; values (?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?,?)&quot;);
BufferedReader bufferReader = new BufferedReader(new FileReader(vars.get(&quot;csv_data_file&quot;)));
vars.putObject(&quot;preparedStmts_&quot; + ${__threadNum}, preparedStmts);
vars.putObject(&quot;bufferReader_&quot; + ${__threadNum}, bufferReader);
vars.putObject(&quot;read_next&quot;, true);</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="吞吐量控制" enabled="true">
          <doubleProp>
            <name>throughput</name>
            <value>5000000.0</value>
            <savedValue>0.0</savedValue>
          </doubleProp>
          <intProp name="calcMode">0</intProp>
        </ConstantThroughputTimer>
        <hashTree/>
        <WhileController guiclass="WhileControllerGui" testclass="WhileController" testname="循环写入" enabled="true">
          <stringProp name="WhileController.condition">${read_next}</stringProp>
        </WhileController>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="写入下一行" enabled="true">
            <stringProp name="scriptLanguage">java</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.sql.*;
import java.io.*;

PreparedStatement preparedStmts = vars.getObject(&quot;preparedStmts_&quot; + ${__threadNum});
BufferedReader bufferReader = vars.getObject(&quot;bufferReader_&quot; + ${__threadNum});
String line = bufferReader.readLine();
if(void != line) {
  	String[] items = line.split(&quot;,&quot;);
  	// 第一列是timestamp类型
  	preparedStmts.setTimestamp(1, new Timestamp(vars.getObject(&quot;dateFormater&quot;).parse(items[0]).getTime()));
  	// 其余列为varchar类型
  	for(int colIndex = 1; colIndex &lt; items.length; ++colIndex) {
  		preparedStmts.setString(colIndex + 1, items[colIndex]);
  	}
  	if (1 != preparedStmts.executeUpdate()) {
  		log.error(&quot;Insert error: &quot; + line);
  	}
} else {
	vars.putObject(&quot;read_next&quot;, false);
}
</stringProp>
          </JSR223Sampler>
          <hashTree/>
        </hashTree>
      </hashTree>
