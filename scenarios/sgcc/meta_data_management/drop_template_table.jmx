      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[Write] 执行数据写入" enabled="false">
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller" enabled="true">
          <boolProp name="LoopController.continue_forever">false</boolProp>
          <stringProp name="LoopController.loops">1</stringProp>
        </elementProp>
        <stringProp name="ThreadGroup.num_threads">${conn_pool_size}</stringProp>
        <stringProp name="ThreadGroup.ramp_time">1</stringProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.duration">${__P(duration,120)}</stringProp>
        <stringProp name="ThreadGroup.delay">1</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="线程对象初始化" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.*
import java.io.*
import org.apache.jmeter.protocol.jdbc.config.DataSourceElement
import java.text.SimpleDateFormat
import java.time.Duration

def formatter = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)

vars.putObject(&quot;date_formatter&quot;, formatter)
Statement stmt = DataSourceElement.getConnection(&quot;default_pool&quot;).createStatement()
stmt.setQueryTimeout(600)
vars.putObject(&quot;stmt&quot;, stmt)
vars.putObject(&quot;sample_data&quot;, new File(vars.get(&quot;csv_sample_data&quot;)).readLines())
vars.putObject(&quot;write_start_at&quot;, System.currentTimeMillis())
vars.putObject(&quot;last_ts&quot;, System.currentTimeMillis())

if(null == vars.get(&quot;write_stop_at&quot;) || vars.get(&quot;write_stop_at&quot;).equals(&quot;-1&quot;)) {
	vars.putObject(&quot;write_stop_at_value&quot;, null)
} else {
	try {
		vars.putObject(&quot;write_stop_at_value&quot;, formatter.parse(vars.get(&quot;write_stop_at&quot;)))
	} catch(Exception ex) {
		log.error(ex.getMessage())
		vars.putObject(&quot;write_stop_at_value&quot;, null)
	}
}

if(null == vars.get(&quot;write_duration&quot;) || vars.get(&quot;write_duration&quot;).equals(&quot;-1&quot;)) {
	vars.putObject(&quot;write_duration_value&quot;, null)
} else {
	try {
		vars.putObject(&quot;write_duration_value&quot;, Duration.parse(vars.get(&quot;write_duration&quot;)).toMillis())
	} catch(Exception ex) {
		log.error(ex.getMessage())
		vars.putObject(&quot;write_duration_value&quot;, null)
	}

}
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
