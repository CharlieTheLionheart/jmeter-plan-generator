              <stringProp name="CounterConfig.start">1</stringProp>
              <stringProp name="CounterConfig.end">${write_limit_per_thread}</stringProp>
              <stringProp name="CounterConfig.incr">1</stringProp>
              <stringProp name="CounterConfig.name">batch_idx</stringProp>
