          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.*
import java.io.*
import java.text.SimpleDateFormat
import java.time.Duration

def formatter = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)

vars.putObject(&quot;date_formatter&quot;, formatter)
def maxCount = Integer.parseInt(vars.get(&quot;insert_lines&quot;))
def rawDatas = new File(vars.get(&quot;csv_sample_data&quot;)).readLines()
def sampleDatas = new ArrayList(maxCount)
for(int i = 0; i &lt; maxCount; i++) {
	sampleDatas.add(rawDatas.get(i % rawDatas.size()))
}
vars.putObject(&quot;sample_data&quot;, sampleDatas)
vars.putObject(&quot;write_start_at&quot;, System.currentTimeMillis())
vars.putObject(&quot;last_ts&quot;, System.currentTimeMillis())
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <ConstantThroughputTimer guiclass="TestBeanGUI" testclass="ConstantThroughputTimer" testname="吞吐量控制" enabled="true">
          <stringProp name="throughput">${write_throughput}</stringProp>
          <intProp name="calcMode">0</intProp>
        </ConstantThroughputTimer>
        <hashTree/>
