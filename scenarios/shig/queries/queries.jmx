SampleResult.setIgnore()</stringProp>
          </JSR223Sampler>
          <hashTree/>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="循环写入" enabled="true">
            <boolProp name="LoopController.continue_forever">true</boolProp>
            <stringProp name="LoopController.loops">${device_count_per_thread}</stringProp>
          </LoopController>
          <hashTree>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="终止判定" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">SampleResult.setIgnore()

def stopAt = vars.getObject(&quot;write_stop_at_value&quot;)
if(null != stopAt) {
	if(stopAt.getTime() &lt;= System.currentTimeMillis()) {
		SampleResult.setStopThread(true)
		return &quot;Write after stop time.&quot;
	}
}

def writeDuration = vars.getObject(&quot;write_duration_value&quot;)
if (null != writeDuration) {
	def writeStartAt = vars.getObject(&quot;write_start_at&quot;)
	if (System.currentTimeMillis() - writeStartAt &gt;= writeDuration) {
		SampleResult.setStopThread(true)
		return &quot;Write timeout.&quot;
	}
}</stringProp>
            </JSR223Sampler>
            <hashTree/>
            <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="写入表: ${ts_db}.electmeter_${__threadNum}_${counter}" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.sql.*
import java.io.*

def nextTs = vars.getObject(&quot;last_ts&quot;)
def builder = new StringBuilder()
builder.append(&quot;insert into ${vars.get(&quot;ts_db&quot;)}.electmeter_${__threadNum}_${vars.getObject(&quot;counter&quot;)} values &quot;)
for(String line in vars.getObject(&quot;sample_data&quot;)) {
  builder.append(&quot;(${nextTs},${line}),&quot;)
  nextTs += Long.parseLong(vars.get(&quot;data_ts_step&quot;))
}
builder.setCharAt(builder.length() - 1, &apos;;&apos; as char)

try{
  def execCode = vars.getObject(&quot;stmt&quot;).executeUpdate(builder.toString())
  if (1 &gt; execCode) {
     SampleResult.setResponseData(&quot;Insert error: ${execCode}&quot;)
     SampleResult.setSuccessful(false)
     SampleResult.setIgnore()
  }
} catch (Exception ex) {
     SampleResult.setResponseData(&quot;Insert error: ${ex.getMessage()}&quot;)
     SampleResult.setSuccessful(false)
     SampleResult.setIgnore()
}
vars.putObject(&quot;last_ts&quot;, nextTs)
SampleResult.setSuccessful(true)
</stringProp>
            </JSR223Sampler>
