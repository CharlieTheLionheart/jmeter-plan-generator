        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0) 写入电表车间关系元数据" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">${workshopElectmeterInsertSql}</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout">600</stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: ${db_name}.electmeter_${__threadNum}" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">def sqlBuilder = new StringBuilder(&quot;insert into db_shig_meta.workshop_electmeter values &quot;)
def threadCount = Integer.parseInt(vars.get(&quot;write_thread_count&quot;));
def devicePerThreadCount = Integer.parseInt(vars.get(&quot;device_count_per_thread&quot;));
def deviceCountPerWorkshop = threadCount * devicePerThreadCount / 100
for (int threadIndex = 1; threadIndex &lt;= threadCount; threadIndex++) {
	for (int deviceIndex = 1; deviceIndex &lt;= devicePerThreadCount; deviceIndex++) {
		int workshopId = threadIndex * devicePerThreadCount / deviceCountPerWorkshop + (deviceIndex - 1) / deviceCountPerWorkshop + 1
	     sqlBuilder.append(&quot;(&apos;&quot; + threadIndex + &quot;_&quot;  + deviceIndex + &quot;&apos;, &quot; + workshopId +  &quot;),&quot;)
	}
}
sqlBuilder.setCharAt(sqlBuilder.length() - 1, &apos;;&apos; as char)
vars.put(&quot;workshopElectmeterInsertSql&quot;, sqlBuilder.toString())</stringProp>
            <stringProp name="scriptLanguage">groovy</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
      </hashTree>
      <ThreadGroup guiclass="ThreadGroupGui" testclass="ThreadGroup" testname="[Write] 执行数据写入(random)" enabled="true">
        <stringProp name="ThreadGroup.num_threads">${write_thread_count}</stringProp>
        <intProp name="ThreadGroup.ramp_time">1</intProp>
        <stringProp name="ThreadGroup.duration">${write_duration}</stringProp>
        <boolProp name="ThreadGroup.same_user_on_next_iteration">true</boolProp>
        <boolProp name="ThreadGroup.scheduler">true</boolProp>
        <stringProp name="ThreadGroup.on_sample_error">continue</stringProp>
        <elementProp name="ThreadGroup.main_controller" elementType="LoopController" guiclass="LoopControlPanel" testclass="LoopController" testname="Loop Controller">
          <stringProp name="LoopController.loops">1</stringProp>
          <boolProp name="LoopController.continue_forever">false</boolProp>
        </elementProp>
      </ThreadGroup>
      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)线程对象初始化" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.*
import java.io.*
import java.text.SimpleDateFormat
import java.time.Duration

def formatter = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)

vars.putObject(&quot;date_formatter&quot;, formatter)
vars.putObject(&quot;write_start_at&quot;, System.currentTimeMillis())
vars.putObject(&quot;last_ts&quot;, System.currentTimeMillis())
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)加载数据" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">String line;
List csv_list = new ArrayList();
List tighten_csv_list = new ArrayList();
List cnc_csv_list = new ArrayList();

def csv_reader = new RandomAccessFile(vars.get(&quot;sample_data&quot;), &quot;r&quot;)
do {
    line = csv_reader.readLine();
    if (line != null) {
        csv_list.add(line);
    }
} while (line != null);
vars.putObject(&quot;csv_list&quot;, csv_list)

def tighten_csv_reader = new RandomAccessFile(vars.get(&quot;sample_tighten_data&quot;), &quot;r&quot;)
do {
    line = tighten_csv_reader.readLine();
    if (line != null) {
        tighten_csv_list.add(line);
    }
} while (line != null);
vars.putObject(&quot;tighten_csv_list&quot;, tighten_csv_list)

def cnc_csv_reader = new RandomAccessFile(vars.get(&quot;sample_cnc_data&quot;), &quot;r&quot;)
vars.putObject(&quot;cnc_csv_reader&quot;, cnc_csv_reader)
do {
    line = cnc_csv_reader.readLine();
    if (line != null) {
        cnc_csv_list.add(line);
    }
} while (line != null);
vars.putObject(&quot;cnc_csv_list&quot;, cnc_csv_list)
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
