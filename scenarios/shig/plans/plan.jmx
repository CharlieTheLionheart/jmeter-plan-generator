			failureMessage += &quot; answer machine_code: &quot; + machine_code1 + &quot;, cur_a: &quot; + cur_a1 + &quot;, cur_b: &quot; + cur_b1 + &quot;, cur_c: &quot; + cur_c1 + &quot;, but actually machine_code: &quot; + machine_code2 + &quot;, cur_a: &quot; + cur_a2 + &quot;, cur_b: &quot; + cur_b2 + &quot;, cur_c: &quot; + cur_c2 + &quot;;&quot;;
			flag = 0;
