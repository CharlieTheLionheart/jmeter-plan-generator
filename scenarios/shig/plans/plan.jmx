                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def count1_ = vars.get(&quot;count1_#&quot;);
def count2_= vars.get(&quot;count2_#&quot;);
if(count1_==count2_){
	def flag = 1;
	String failureMessage = &quot;[in &amp;&amp; group by]&quot;;
	for(int i=1;i&lt;=count1_;i++){
		String k = String.valueOf(i);
		def count1 = vars.get(&quot;count1_&quot; + k);
		def count2= vars.get(&quot;count2_&quot; + k);
		def name1 = vars.get(&quot;name1_&quot; + k);
		def name2 = vars.get(&quot;name2_&quot; + k);
		if(!((count1 == count2) &amp;&amp; (name1 == name2))){
			failureMessage += &quot; answer elect_name: &quot; + name1 + &quot;, count: &quot; + count1 + &quot;, but actually elect_name: &quot; + name2 + &quot;, count: &quot; + count2 + &quot;;&quot;;
			flag = 0;
		}
	}
	if(flag == 1){
		AssertionResult.setFailure(false);
	}else{
		AssertionResult.setFailure(true);
		AssertionResult.setFailureMessage(failureMessage);
	}
}else{
	String failureMessage = &quot;[in &amp;&amp; group by] machine_code: &quot; + machine_code + &quot;, answer result_row_count: &quot; + count1_ + &quot;, but actually result_row_count: &quot; + count2_;
	AssertionResult.setFailure(true);
	AssertionResult.setFailureMessage(failureMessage);
}
</stringProp>
