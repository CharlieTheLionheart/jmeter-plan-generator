            <stringProp name="dataSource">default_pool</stringProp>
            <stringProp name="queryType">Select Statement</stringProp>
            <stringProp name="query">select sum(allenergy_a) from
  (select we.machine_code as machine_code from db_shig_meta.factory f, db_shig_meta.workshop w, db_shig_meta.workshop_electmeter we
           where we.workshop_id = w.id and f.id = w.factory_id and f.sub_comp_id = 1) m,
  db_shig.t_electmeter e where e.machine_code = m.machine_code
and k_timestamp &gt; &apos;${q_begin_ts}&apos; and k_timestamp &lt; &apos;${q_end_ts}&apos;</stringProp>
            <stringProp name="queryArguments">${machine_code}</stringProp>
            <stringProp name="queryArgumentsTypes">varchar</stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
          </JDBCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="获取当前时间的月初和月末时间" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">false</stringProp>
              <stringProp name="script">import java.time.LocalDateTime;
import java.time.format.DateTimeFormatter;
import java.time.temporal.TemporalAdjusters;

DateTimeFormatter dtf = DateTimeFormatter.ofPattern(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;);
LocalDateTime now = LocalDateTime.now();
LocalDateTime monthBegin = LocalDateTime.of(now.getYear(), now.getMonth(), 1, 0, 0, 0);
LocalDateTime monthEnd = LocalDateTime.of(now.getYear(), now.getMonth(), now.with(TemporalAdjusters.lastDayOfMonth()).getDayOfMonth(), 23, 59, 59);

vars.put(&quot;q_begin_ts&quot;, dtf.format(monthBegin))
vars.put(&quot;q_end_ts&quot;, dtf.format(monthEnd))

log.info(&quot;q_begin_ts={}&quot;, vars.get(&quot;q_begin_ts&quot;))
log.info(&quot;q_end_ts={}&quot;, vars.get(&quot;q_end_ts&quot;))</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
