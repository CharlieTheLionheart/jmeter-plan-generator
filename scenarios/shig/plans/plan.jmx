        </IfController>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="set cluster setting sql.add_bo_white_list =${bo_white_list}" enabled="true">
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="script">void generateBatchSettingSQL() {
  def bo_white_list_builder = new StringBuilder()
  def whiteLists=vars.get(&quot;bo_white_list&quot;).substring(1, vars.get(&quot;bo_white_list&quot;).length()-1)
  for (item in whiteLists.split(&quot;;&quot;)) {
  	bo_white_list_builder.append(&quot;set cluster setting sql.add_bo_white_list = &quot;)
  	bo_white_list_builder.append(item)
  	bo_white_list_builder.append(&quot;;&quot;)
  }
  log.debug(&quot;bo_white_list_builder={}&quot;, bo_white_list_builder.toString())
  vars.put(&quot;bo_white_list_builder&quot;, bo_white_list_builder.toString())
  println bo_white_list_builder.toString()
}

generateBatchSettingSQL()</stringProp>
