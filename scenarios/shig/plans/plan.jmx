            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">vars.putObject(&quot;begin_timestamp&quot;, ${__timeShift(,,PT-121M,,)})
vars.putObject(&quot;end_timestamp&quot;, ${__timeShift(,,PT-10M,,)})
def query_machine_code = &quot;${__Random(1,${write_thread_count},)}_${__Random(1,${device_rand_end},)}&quot;
vars.putObject(&quot;machine_code&quot;, query_machine_code)
log.warn(&quot;query_machine_code=&quot; + query_machine_code)
log.warn(&quot;elect_name_expect=${__P(elect_name_expect,)}&quot;)</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.jmeter.util.JMeterUtils;

String maxCurExpect = JMeterUtils.getProperty(&quot;max_cur_expect&quot;)
String minCurExpect = JMeterUtils.getProperty(&quot;min_cur_expect&quot;)
String avgCurExpect = JMeterUtils.getProperty(&quot;avg_cur_expect&quot;)

if (vars.get(&quot;max_cur_1&quot;) == null) {
    AssertionResult.setFailureMessage(&quot;query result is empty&quot;)
    AssertionResult.setFailure(true)
    return
}

String maxCurActual = vars.get(&quot;max_cur_1&quot;)
String minCurActual = vars.get(&quot;min_cur_1&quot;)
String avgCurActual = vars.get(&quot;avg_cur_1&quot;)
String avgSumActual = vars.get(&quot;sum_cur_1&quot;)
String avgCountActual = vars.get(&quot;count_cur_1&quot;)

double delta = 1e-8

if (Math.abs(Double.parseDouble(maxCurExpect) - Double.parseDouble(maxCurActual)) &lt; delta &amp;&amp; Math.abs(Double.parseDouble(minCurExpect) - Double.parseDouble(minCurActual)) &lt; delta &amp;&amp; Math.abs(Double.parseDouble(avgCurExpect) - Double.parseDouble(avgCurActual)) &lt; delta) {
    AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailure(true)
    beginTimestamp = vars.get(&quot;begin_timestamp&quot;)
    endTimestamp = vars.get(&quot;end_timestamp&quot;)
    machineCode = vars.get(&quot;machine_code&quot;)
    AssertionResult.setFailureMessage(
        &quot;begin_timestamp=&quot; + beginTimestamp + 
        &quot;,\nend_timestamp=&quot; + endTimestamp + 
        &quot;,\nmachine_code=&quot; + machineCode + 
        &quot;,\nmaxCurExpect=&quot; + maxCurExpect + 
        &quot;,\nmaxCurActual=&quot; + maxCurActual + 
        &quot;,\nminCurExpect=&quot; + minCurExpect + 
        &quot;,\nminCurActual=&quot; + minCurActual + 
        &quot;,\navgCurExpect=&quot; + avgCurExpect + 
        &quot;,\navgCurActual=&quot; + avgCurActual + 
        &quot;,\navgCountActual=&quot; + avgCountActual + 
        &quot;,\navgSumActual=&quot; + avgSumActual)
}</stringProp>
              </JSR223Assertion>
