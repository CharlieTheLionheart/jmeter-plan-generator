                <stringProp name="script">int cncCountActual = Integer.parseInt(vars.get(&quot;cnc_count_actual_1&quot;))
int cncCountExpect = Integer.parseInt(vars.get(&quot;cnc_count_expect&quot;))
int batchWriteLines = Integer.parseInt(vars.get(&quot;write_lines&quot;))

if ( cncCountActual % batchWriteLines == 0 ) {
