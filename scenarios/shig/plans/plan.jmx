                <stringProp name="script">import java.sql.*
import java.io.*
import java.util.List
import java.util.ArrayList

List generateTimestampList() {
  def nextTs = vars.getObject(&quot;last_ts&quot;)
  int lineNum = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;))
  def tsList = new ArrayList()
  for(int lineNumIdx = 0; lineNumIdx &lt; lineNum; lineNumIdx++){
    tsList.add(nextTs)
    nextTs += dataTsStep
  }
  vars.putObject(&quot;last_ts&quot;, nextTs)
  return tsList
}

List getSwapedListOrNot() {
  int index = Integer.parseInt(vars.get(&quot;batch_idx&quot;))
  int disorderBatchInterval = Integer.parseInt(vars.get(&quot;disorder_batch_interval&quot;))
  log.debug(&quot;index={}&quot;, index)
  log.debug(&quot;disorderBatchInterval={}&quot;, disorderBatchInterval)
  if (disorderBatchInterval != 0 &amp;&amp; index % disorderBatchInterval == 0) {
	tmpList = generateTimestampList().swap(0, Integer.parseInt(vars.get(&quot;swap_line_idx&quot;)))
	log.debug(&quot;tmpList={}&quot;, tmpList)
    return tmpList
  }
  return generateTimestampList()
}

