            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="SQL7: sumpallpower" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="query">select sum(pallpower) as sumpallpower, count(1) as countall from db_shig.t_electmeter t where 1=1 and t.k_timestamp &gt; (${begin_timestamp})::timestamptz and t.k_timestamp &lt; (${end_timestamp})::timestamptz;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">sumpallpower,countall</stringProp>
              <stringProp name="resultVariable">result_list</stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">vars.putObject(&quot;begin_timestamp&quot;, ${__timeShift(,,PT-20M,,)})
vars.putObject(&quot;end_timestamp&quot;, ${__timeShift(,,PT-10M,,)})</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.jmeter.util.JMeterUtils;
import java.math.BigDecimal;
import java.math.RoundingMode;

BigDecimal sumPallpowerInCsv = new BigDecimal(JMeterUtils.getProperty(&quot;sum_pallpower_in_csv&quot;).replaceAll(&quot;&apos;&quot;, &quot;&quot;))
BigDecimal csvLineAmount = new BigDecimal(JMeterUtils.getProperty(&quot;csv_line_amount&quot;).replaceAll(&quot;&apos;&quot;, &quot;&quot;))

if (vars.get(&quot;sumpallpower_1&quot;) == null || vars.get(&quot;countall_1&quot;) == null) {
	AssertionResult.setFailureMessage(&quot;sumpallpower_1 and countall_1 is null&quot;)
	AssertionResult.setFailure(true)
	return
}

BigDecimal sumPallpowerActual = new BigDecimal(vars.get(&quot;sumpallpower_1&quot;))
BigDecimal countallActual = new BigDecimal(vars.get(&quot;countall_1&quot;))

log.debug(&quot;sumPallpowerActual: &quot; + sumPallpowerActual.toString())
log.debug(&quot;countallActual: &quot; + countallActual.toString())
log.debug(&quot;sumPallpowerInCsv: &quot; + sumPallpowerInCsv.toString())
log.debug(&quot;csvLineAmount: &quot; + csvLineAmount.toString())

BigDecimal sumPallpowerExpect = sumPallpowerInCsv.multiply(countallActual).divide(csvLineAmount).setScale(16, RoundingMode.HALF_UP)
log.debug(&quot;sumPallpowerExpect: &quot; + sumPallpowerExpect.toString())

def differ = (sumPallpowerActual.subtract(sumPallpowerExpect)).divide(sumPallpowerExpect, BigDecimal.ROUND_HALF_UP).setScale(16, RoundingMode.HALF_UP)

if ( Math.abs(differ) &lt; 1E-5 ) {
    AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailureMessage(&quot;sumPallpowerExpect: &quot; + sumPallpowerExpect + &quot;,sumPallpowerActual: &quot; + sumPallpowerActual)
    AssertionResult.setFailure(true)
}</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="commit(SQL7: sumpallpower)" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Commit</stringProp>
              <stringProp name="query"></stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
