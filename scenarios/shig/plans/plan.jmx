          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)预处理部分列插入数据: ${db_name}.electmeter_column_merge_${__threadNum}" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.sql.*
import java.io.*
import java.util.List
import java.util.ArrayList

List generateTimestampList() {
  def nextTs = System.currentTimeMillis()
  int lineNum = 10
  long dataTsStep = 5
  def tsList = new ArrayList()
  for(int lineNumIdx = 0; lineNumIdx &lt; lineNum; lineNumIdx++){
    tsList.add(nextTs)
    nextTs += dataTsStep
  }
  vars.putObject(&quot;last_ts&quot;, nextTs)
  return tsList
}


void generateBatchInsertSQL() {
// column       vol_ab, vol_bc, vol_ac can be null
// builder1:    0.0   , null  , null
// builder2:    null  , 1.0   , 1.0
// builder3:    null  , null  , 2.0
// after merge: 0.0   , 1,0   , 2,0

	String[] strs = [&quot;&apos;NULL&apos;,299.4,0.01,0.01,0,88915,218893,105646,105646,0.31,0.72,0.16,299.5,0.03,0.6,4436,86837,3,29679,29679,0.06,0.62,0.87,299.5,0.02,0.58,99058,61254,14,0,0,0.97,0.25,0.18,0.0,null,null,50.09,0.41,0.125,3765.66,0.59,0.61,0.17,2069.16,2069.16&quot;,
	&quot;&apos;a017&apos;,299.5,0.07,0.02,0,0,2,33112,33112,0.42,0.42,0.9,299.4,0.05,0.71,72159,59126,1,141800,141800,0.38,0.41,0.18,299.4,0.01,0.05,137195,164991,9,250000,250000,0.01,0.71,0.53,null,1.0,1.0,49.86,0.93,0.135,1077.7,0.49,0.22,0.35,1204.39,1204.39&quot;,
	&quot;&apos;NULL&apos;,299.6,0.07,0.03,0,0,5,0,0,0.5,0.54,0.47,299.5,0.12,0.45,125554,250000,6,76932,76932,0.17,0.79,0.69,299.6,0.19,0.12,71144,37193,4,249115,249115,0.9,0.45,0.17,null,null,2.0,50.07,0.17,0.16,3784.95,0.51,0.64,0.65,597.74,597.74&quot;]
  StringBuilder[] builders = [new StringBuilder(),new StringBuilder(),new StringBuilder()]
  for (int i = 0; i &lt; 3 ;i++)
  	builders[i].append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.electmeter_column_merge values &quot;)
  def swapedList = generateTimestampList()
  def maxCount = 10
  for(int lineIdx = 0; lineIdx &lt; maxCount; lineIdx++) {
  	ts = swapedList.get(lineIdx)
	for (int i = 0; i &lt; 3 ;i++)
		builders[i].append(&quot;(${ts},${strs[i]}),&quot;)
  }
  for (int i = 0; i &lt; 3 ;i++){
  	builders[i].setCharAt(builders[i].length() - 1, &apos;;&apos; as char)

  	vars.put(&quot;builder${i+1}&quot;, builders[i].toString())
  }


}

generateBatchInsertSQL()
SampleResult.setIgnore()</stringProp>
