            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="last all of electmeter in south region by page" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="query">select m.sub_company_name,
       m.factory_name,
       m.workshop_name,
       e.*
  from
  (select s.id as sub_company_id,
          max(s.name) as sub_company_name,
          f.id as factory_id,
          max(f.name) as factory_name,
          w.id as workshop_id,
          max(w.name) as workshop_name
     from db_shig_meta.sub_company s,
          db_shig_meta.factory f,
          db_shig_meta.workshop w
    where f.id = w.factory_id
      and f.sub_comp_id = s.id
      and s.region = &apos;南方大区&apos; 
 group by s.id, f.id, w.id) m 
left join
  (select last(*),
          workshop_id
     from db_shig.t_electmeter
 group by workshop_id)  e
       on e.workshop_id = m.workshop_id
 order by m.sub_company_id, m.factory_id, m.workshop_id
 limit ${page_size} offset ${page_start}</stringProp>
