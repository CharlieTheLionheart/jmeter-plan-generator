            <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="计算插入前后的差值并断言" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">import java.sql.*
import java.io.*
import java.util.List
import java.util.ArrayList

int lineNum = Integer.parseInt(vars.get(&quot;write_lines&quot;));
int should = (lineNum+1)/2;

int beforeCount = Integer.parseInt(vars.get(&quot;before_count_1&quot;));
int afterCount = Integer.parseInt(vars.get(&quot;after_count_1&quot;));

if(afterCount - beforeCount == should){
	AssertionResult.setFailure(false);

}else{
	AssertionResult.setFailure(true);
	FailureMessage = &quot;afterCount:&quot; + afterCount + &quot;, beforeCount&quot; + beforeCount + &quot;, differ: &quot; + (afterCount - beforeCount) + &quot;, but actually: &quot; + should;
	AssertionResult.setFailureMessage(FailureMessage);
}
</stringProp>
