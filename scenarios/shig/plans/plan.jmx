            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">String ddl = &quot;create table &quot;
int start = Integer.parseInt(vars.get(&quot;device_rand_start&quot;))
int end = start - 1 + Integer.parseInt(vars.get(&quot;device_count_per_thread&quot;))
for(int i=start; i&lt;=end; i++){
	ddl = ddl + &quot; ${db_name}.electmeter_${__threadNum}_${i} USING ${db_name}.t_electmeter tags (&apos;${__threadNum}_${i}&apos;) &quot;
}
ddl = ddl + &quot;;&quot;
vars.put(&quot;create_ddl&quot;, ddl)
SampleResult.setIgnore()</stringProp>
