            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="SQL2: last curs with machine_code" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="query">SELECT last_row(*) FROM db_shig.t_cnc WHERE machine_code = ?;</stringProp>
              <stringProp name="queryArguments">1_8</stringProp>
              <stringProp name="queryArgumentsTypes">varchar</stringProp>
              <stringProp name="variableNames">k_timestamp,cnc_sn,cnc_sw_mver,cnc_sw_sver,cnc_tol_mem,cnc_use_mem,cnc_unuse_mem,cnc_status,path_quantity,axis_quantity,axis_path,axis_type,axis_unit,axis_num,axis_name,sp_name,abs_pos,rel_pos,mach_pos,dist_pos,sp_override,sp_set_speed,sp_act_speed,sp_load,feed_set_speed,feed_act_speed,feed_override,servo_load,parts_count,cnc_cycletime,cnc_alivetime,cnc_cuttime,cnc_runtime,mprog_name,mprog_num,sprog_name,sprog_num,prog_seq_num,prog_seq_content,alarm_count,alarm_type,alarm_code,alarm_content,alarm_time,cur_tool_num,cur_tool_len_num,cur_tool_len,cur_tool_len_val,cur_tool_x_len,cur_tool_x_len_val,cur_tool_y_len,cur_tool_y_len_val,cur_tool_z_len,cur_tool_z_len_val,cur_tool_rad_num,cur_tool_rad,cur_tool_rad_val,device_state,value1,value2,value3,value4,value5,machine_code,op_group,workshop_id,number_of_molds</stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.jmeter.util.JMeterUtils;

String lastCncExpect = JMeterUtils.getProperty(&quot;last_cnc_expect&quot;).replaceAll(&quot;&apos;&quot;, &quot;&quot;)

if (vars.get(&quot;k_timestamp_1&quot;) == null) {
    AssertionResult.setFailureMessage(&quot;query result is empty&quot;)
    AssertionResult.setFailure(true)
    return
}

List&lt;String&gt; fieldList = new ArrayList()
fieldList.add(vars.get(&quot;k_timestamp_1&quot;))
fieldList.add(vars.get(&quot;cnc_sn_1&quot;))
fieldList.add(vars.get(&quot;cnc_sw_mver_1&quot;))
fieldList.add(vars.get(&quot;cnc_sw_sver_1&quot;))
