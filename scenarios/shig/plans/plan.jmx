      <hashTree>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)线程对象初始化" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">import java.sql.*
import java.io.*
import java.text.SimpleDateFormat
import java.time.Duration

def formatter = new SimpleDateFormat(&quot;yyyy-MM-dd HH:mm:ss.SSS&quot;)

vars.putObject(&quot;date_formatter&quot;, formatter)
vars.putObject(&quot;write_start_at&quot;, System.currentTimeMillis())
vars.putObject(&quot;last_ts&quot;, System.currentTimeMillis())
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
        <hashTree/>
        <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)加载数据" enabled="true">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">def csv_reader = new RandomAccessFile(vars.get(&quot;sample_data&quot;), &quot;r&quot;)
vars.putObject(&quot;csv_reader&quot;, csv_reader)
def tighten_csv_reader = new RandomAccessFile(vars.get(&quot;sample_tighten_data&quot;), &quot;r&quot;)
vars.putObject(&quot;tighten_csv_reader&quot;, tighten_csv_reader)
def cnc_csv_reader = new RandomAccessFile(vars.get(&quot;sample_cnc_data&quot;), &quot;r&quot;)
vars.putObject(&quot;cnc_csv_reader&quot;, cnc_csv_reader)
SampleResult.setIgnore()</stringProp>
        </JSR223Sampler>
