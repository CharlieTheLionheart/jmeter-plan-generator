import java.io.*
import java.util.List
import java.util.ArrayList
import com.kaiwudb.svt.utils.ctx.DataSeedCtx
import com.kaiwudb.svt.model.RowData
import com.kaiwudb.svt.model.CommaSplitTextData

List generateTimestampList() {
  def nextTs = System.currentTimeMillis()
  int lineNum = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;))
  def tsList = new ArrayList()
  for(int lineNumIdx = 0; lineNumIdx &lt; lineNum; lineNumIdx++){
    tsList.add(nextTs)
    nextTs += dataTsStep
  }
  return tsList
}

void generateBatchInsertSQL() {
  def cnc_list = DataSeedCtx.getRowDataList(&quot;${db_name}.t_cnc&quot;)
  def cnc_builder = new StringBuilder()
  int workshop_id = (Integer.parseInt(&quot;${__threadNum}&quot;) - 1) * 5 + (Integer.parseInt(vars.get(&quot;device_num&quot;)) - 1) % 5 + 1
  int factory_id = (workshop_id + 4) / 5
  int sub_company_id = (factory_id + 4) / 5
  cnc_builder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_cnc (k_timestamp, cnc_sn, cnc_sw_mver, cnc_sw_sver, cnc_tol_mem, cnc_use_mem, cnc_unuse_mem, cnc_status, path_quantity, axis_quantity, axis_path, axis_type, axis_unit, axis_num, axis_name, sp_name, abs_pos, rel_pos, mach_pos, dist_pos, sp_override, sp_set_speed, sp_act_speed, sp_load, feed_set_speed, feed_act_speed, feed_override, servo_load, parts_count, cnc_cycletime, cnc_alivetime, cnc_cuttime, cnc_runtime, mprog_name, mprog_num, sprog_name, sprog_num, prog_seq_num, prog_seq_content, alarm_count, alarm_type, alarm_code, alarm_content, alarm_time, cur_tool_num, cur_tool_len_num, cur_tool_len, cur_tool_len_val, cur_tool_x_len, cur_tool_x_len_val, cur_tool_y_len, cur_tool_y_len_val, cur_tool_z_len, cur_tool_z_len_val, cur_tool_rad_num, cur_tool_rad, cur_tool_rad_val, device_state, value1, value2, value3, value4, value5, machine_code, op_group, sub_company_id, factory_id, workshop_id, number_of_molds) values &quot;)

  def timestampedList = generateTimestampList()
  def maxCount = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  for(int lineIdx = 0; lineIdx &lt; maxCount; lineIdx++) {
  	def nextLine = ((CommaSplitTextData) cnc_list.get(lineIdx)).getDataLine()
	  cnc_builder.append(&quot;(${timestampedList.get(lineIdx)},${nextLine},&apos;${__threadNum}_${vars.get(&quot;device_num&quot;)}&apos;,&apos;op_group_${__threadNum}&apos;,&quot;)
	  cnc_builder.append(sub_company_id + &quot;,&quot;)
	  cnc_builder.append(factory_id + &quot;,&quot;)
	  cnc_builder.append(workshop_id + &quot;,&quot;)
	  cnc_builder.append(&quot;${__Random(1,20,)}),&quot;)
  }
  cnc_builder.setCharAt(cnc_builder.length() - 1, &apos;;&apos; as char)

  vars.put(&quot;cnc_builder&quot;, cnc_builder.toString())
}

