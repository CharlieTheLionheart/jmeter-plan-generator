            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="assert total count of t_electmeter" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="query">select count(*) from db_shig.t_electmeter where 1=1;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">electmeter_count_actual</stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">int electmeterCountActual = Integer.parseInt(vars.get(&quot;electmeter_count_actual_1&quot;))
int electmeterCountExpect = Integer.parseInt(vars.get(&quot;electmeter_count_expect&quot;))
int batchWriteLines = Integer.parseInt(vars.get(&quot;write_lines&quot;))

if ( electmeterCountActual % batchWriteLines == 0 ) {
    AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailureMessage(&quot;electmeterCountActual is not a multiple of 100&quot;)
    AssertionResult.setFailure(true)
}

if ( electmeterCountActual &gt;= electmeterCountExpect * 0.95 ) {
    AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailureMessage(&quot;electmeterCountExpect: &quot; + electmeterCountExpect + &quot;,electmeterCountActual: &quot; + electmeterCountActual)
    AssertionResult.setFailure(true)
}</stringProp>
              </JSR223Assertion>
