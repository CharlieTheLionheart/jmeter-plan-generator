    fieldList.add(vars.get(&quot;powerl_c_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;vol_ab_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;vol_bc_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;vol_ca_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;infre_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;powerf_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;allpower_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;pallpower_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;rallpower_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;powerr_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;powerl_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;allrenergy1_&quot; + resultIndex))
    fieldList.add(vars.get(&quot;allrenergy2_&quot; + resultIndex))
    
    String lastElectmeterActual = String.join(&quot;,&quot;, fieldList)
    if ( lastElectmeterActual.equals(lastElectmeterExpect) ) {
        AssertionResult.setFailure(false)
    } else {
        AssertionResult.setFailureMessage(&quot;result list row index:&quot; + resultIndex + &quot;,lastElectmeterExpect: &quot; + lastElectmeterExpect + &quot;,lastElectmeterActual: &quot; + lastElectmeterActual)
        AssertionResult.setFailure(true)
        break
    }
}</stringProp>
              </JSR223Assertion>
