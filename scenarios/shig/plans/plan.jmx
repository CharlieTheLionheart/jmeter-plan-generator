          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="(2.0.0)预处理数据: ${db_name}.electmeter_sample" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.sql.*
import java.io.*
import java.util.List
import java.util.ArrayList

List generateTimestampList() {
  def nextTs = System.currentTimeMillis()
  int lineNum = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;))
  def tsList = new ArrayList()
  for(int lineNumIdx = 0; lineNumIdx &lt; lineNum; lineNumIdx++){
    tsList.add(nextTs)
    nextTs += dataTsStep
  }
  return tsList
}

void generateBatchInsertSQL() {
  def builder = new StringBuilder()
  builder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.electmeter_sample values &quot;)
  int lineIdx = 0
  def swapedList = generateTimestampList()
  for(String line in vars.getObject(&quot;sample_data&quot;)) {
    builder.append(&quot;(${swapedList.get(lineIdx)},${line}),&quot;)
    lineIdx++
  }
  builder.setCharAt(builder.length() - 1, &apos;;&apos; as char)
  log.debug(&quot;builder={}&quot;, builder.toString())
  vars.put(&quot;builder&quot;, builder.toString())
}

generateBatchInsertSQL()</stringProp>
