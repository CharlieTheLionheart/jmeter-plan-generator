                  <stringProp name="script">import java.sql.*
import java.io.*
import java.util.List
import java.util.ArrayList
import com.kaiwudb.svt.utils.ctx.DataSeedCtx
import com.kaiwudb.svt.model.RowData
import com.kaiwudb.svt.model.CommaSplitTextData

List generateTimestampList() {
  def nextTs = vars.getObject(&quot;last_ts&quot;)
  int lineNum = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;))
  def tsList = new ArrayList()
  for(int lineNumIdx = 0; lineNumIdx &lt; lineNum; lineNumIdx++){
    tsList.add(nextTs)
    nextTs += dataTsStep
  }
  vars.putObject(&quot;last_ts&quot;, nextTs)
  return tsList
}

void generateBatchInsertSQL() {
  def cnc_list = DataSeedCtx.getRowDataList(&quot;${db_name}.t_cnc&quot;)
  def cnc_builder = new StringBuilder()
  int workshop_id = (Integer.parseInt(&quot;${__threadNum}&quot;) - 1) * 5 + (Integer.parseInt(vars.get(&quot;device_num&quot;)) - 1) % 5 + 1
  int factory_id = (workshop_id + 4) / 5
  int sub_company_id = (factory_id + 4) / 5
  cnc_builder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_cnc values &quot;)
  def timestampedList = generateTimestampList()
  def maxCount = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  for(int lineIdx = 0; lineIdx &lt; maxCount; lineIdx++) {
  	def nextLine = ((CommaSplitTextData) cnc_list.get(lineIdx)).getDataLine()
	  cnc_builder.append(&quot;(${timestampedList.get(lineIdx)},${nextLine},&apos;${__threadNum}_${vars.get(&quot;device_num&quot;)}&apos;),&quot;)
  }
  cnc_builder.setCharAt(cnc_builder.length() - 1, &apos;;&apos; as char)

  vars.put(&quot;cnc_builder&quot;, cnc_builder.toString())
}

