            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0)torque-angle" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="query">select &apos;${machine_code}&apos; as machine_code, count(k_timestamp), avg(torque), avg(angle) from (select k_timestamp, torque, angle from db_shig.tighten_${machine_code} where device_state=0 and k_timestamp &gt; (${begin_timestamp})::timestamp and k_timestamp &lt; (${end_timestamp})::timestamp order by ${order_by});</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">machine_code1,count1,torque1,angle1</stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">vars.putObject(&quot;begin_timestamp&quot;, ${__timeShift(,,PT-1440001M,,)})
vars.putObject(&quot;end_timestamp&quot;, ${__timeShift(,,PT-1M,,)})
vars.putObject(&quot;machine_code&quot;, &quot;${__Random(1,${write_thread_count},)}_${__Random(1,${device_rand_end},)}&quot;)</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
            </hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="[TD]torque-angle" enabled="true">
              <stringProp name="dataSource">td_pool</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="query">select &apos;${machine_code}&apos; as machine_code, count(k_timestamp), avg(torque), avg(angle) from (select k_timestamp, torque, angle from db_shig.tighten_${machine_code} where device_state=0 and k_timestamp &gt; ${begin_timestamp} and k_timestamp &lt; ${end_timestamp} order by ${order_by});</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">machine_code2,count2,torque2,angle2</stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">def machine_code1 = vars.get(&quot;machine_code1_1&quot;);
def machine_code2= vars.get(&quot;machine_code2_1&quot;);
def count1 = vars.get(&quot;count1_1&quot;);
def count2 = vars.get(&quot;count2_1&quot;);
def torque1 = vars.get(&quot;torque1_1&quot;);
def torque2 = vars.get(&quot;torque2_1&quot;);
def angle1 = vars.get(&quot;angle1_1&quot;);
def angle2 = vars.get(&quot;angle2_1&quot;);
if(machine_code1==machine_code2 &amp;&amp; count1==count2 &amp;&amp; torque1==torque2 &amp;&amp; angle1==angle2){
	AssertionResult.setFailure(false);
}else{
	String failureMessage = &quot;[torque-angle] answer machine_code: &quot; + machine_code1 + &quot;, count: &quot; + count1 + &quot;, torque: &quot; + torque1 + &quot;, angle: &quot; + angle1 +  &quot;, but actually machine_code: &quot; + machine_code2 + &quot;, count: &quot; + count2 + &quot;, torque: &quot; + torque2 + &quot;, angle: &quot; + angle2;
	AssertionResult.setFailure(true);
	AssertionResult.setFailureMessage(failureMessage);
}
</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
          </hashTree>
        </hashTree>
      </hashTree>
