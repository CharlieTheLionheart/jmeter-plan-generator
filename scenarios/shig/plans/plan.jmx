        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="查询下推BO白名单表达式不为空" enabled="true">
          <stringProp name="TestPlan.comments">d41d8cd98f00b204e9800998ecf8427e:md5 value of empty string</stringProp>
          <stringProp name="IfController.condition">${__groovy(vars.get(&quot;bo_white_list&quot;).length()&gt;2,)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
