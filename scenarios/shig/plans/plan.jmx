        <OnceOnlyController guiclass="OnceOnlyControllerGui" testclass="OnceOnlyController" testname="[Setup] 特征值处理" enabled="true"/>
        <hashTree>
          <JSR223Sampler guiclass="TestBeanGUI" testclass="JSR223Sampler" testname="[Setup] 特征值处理" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import org.apache.jmeter.util.JMeterUtils;
import java.math.BigDecimal;
import java.math.RoundingMode;
import com.kaiwudb.svt.utils.ctx.DataSeedCtx;
import com.kaiwudb.svt.model.RowData;
import com.kaiwudb.svt.model.CommaSplitTextData;

List electmeter_list = DataSeedCtx.getRowDataList(&quot;${db_name}.t_electmeter&quot;);
List cnc_list = DataSeedCtx.getRowDataList(&quot;${db_name}.t_cnc&quot;);

// SQL3&amp;SQL8: last_electmeter_expect
JMeterUtils.setProperty(&quot;last_electmeter_expect&quot;, ((CommaSplitTextData)electmeter_list.get(electmeter_list.size() - 1)).getDataLine())

// not used, preserved for later test case
JMeterUtils.setProperty(&quot;last_cnc_expect&quot;, ((CommaSplitTextData)cnc_list.get(cnc_list.size() - 1)).getDataLine())

// SQL1: sp_act_speed_list_expect
List spActSpeedListExpect = new ArrayList();
for (RowData cnc_line : cnc_list) {
    cnc_col_arr = ((CommaSplitTextData) cnc_line).getDataLine().split(&quot;,&quot;)
    spActSpeedListExpect.add(cnc_col_arr[21].replaceAll(&quot;&apos;&quot;,&quot;&quot;))
}
spActSpeedListString = spActSpeedListExpect.toString().replaceAll(&quot; &quot;,&quot;&quot;)
JMeterUtils.setProperty(&quot;sp_act_speed_list_expect&quot;, spActSpeedListString.substring(1, spActSpeedListString.length() - 1))

// SQL4: max_cur_expect min_cur_expect avg_cur_expect &amp; SQL7: sum pallpower
BigDecimal max_cur = new BigDecimal(0)
BigDecimal min_cur = new BigDecimal(0)
BigDecimal sum_cur = new BigDecimal(0)
BigDecimal sum_pallpower = new BigDecimal(0)
BigDecimal sum_allenergy_a = new BigDecimal(0)
int count = 0;

if (electmeter_list == null || electmeter_list.isEmpty()) {
	log.error(&quot;electmeter_list is null or empty&quot;)
	return
}

String elect_name_expect = ((CommaSplitTextData) electmeter_list.get(0)).getDataLine().split(&quot;,&quot;)[0]
String elect_name_expect_trim = elect_name_expect.substring(1, elect_name_expect.length() - 1)
log.warn(&quot;elect_name_expect=&quot; + elect_name_expect_trim)
JMeterUtils.setProperty(&quot;elect_name_expect&quot;, elect_name_expect_trim)

for (RowData elect_line : electmeter_list) {
    elect_col_arr = ((CommaSplitTextData) elect_line).getDataLine().split(&quot;,&quot;)
    if (elect_name_expect.equals(elect_col_arr[0])) {
        BigDecimal line_cur_a = new BigDecimal(elect_col_arr[2])
        if (count == 0) {
            max_cur = line_cur_a
            min_cur = line_cur_a
        }
        if (line_cur_a.compareTo(max_cur) &gt; 0) {
            max_cur = line_cur_a;
        }
        if (line_cur_a.compareTo(min_cur) &lt; 0) {
            min_cur = line_cur_a;
        }
        sum_cur = sum_cur.add(line_cur_a);
        count++;
    }
    BigDecimal line_pallpower = new BigDecimal(elect_col_arr[40])
    sum_pallpower = sum_pallpower.add(line_pallpower);

    BigDecimal line_allenergy_a = new BigDecimal(elect_col_arr[4])
    sum_allenergy_a = sum_allenergy_a.add(line_allenergy_a)
}
log.debug(max_cur.toString())
log.debug(min_cur.toString())
log.debug(sum_cur.toString())
log.debug(sum_pallpower.toString())
log.debug(sum_allenergy_a.toString())
log.debug(count + &quot;&quot;)
log.debug(electmeter_list.size() + &quot;&quot;)
BigDecimal avg_cur = sum_cur.divide(new BigDecimal(count), RoundingMode.HALF_UP).setScale(16, RoundingMode.HALF_UP)
JMeterUtils.setProperty(&quot;max_cur_expect&quot;, max_cur.setScale(2, RoundingMode.HALF_UP).toString())
JMeterUtils.setProperty(&quot;min_cur_expect&quot;, min_cur.setScale(2, RoundingMode.HALF_UP).toString())
JMeterUtils.setProperty(&quot;avg_cur_expect&quot;, avg_cur.setScale(16, RoundingMode.HALF_UP).toString())
JMeterUtils.setProperty(&quot;sum_pallpower_in_csv&quot;, sum_pallpower.setScale(16, RoundingMode.HALF_UP).toString())
JMeterUtils.setProperty(&quot;sum_allenergy_a_in_csv&quot;, sum_allenergy_a.setScale(2, RoundingMode.HALF_UP).toString())
JMeterUtils.setProperty(&quot;csv_line_amount&quot;, electmeter_list.size() + &quot;&quot;)

SampleResult.setIgnore()</stringProp>
          </JSR223Sampler>
