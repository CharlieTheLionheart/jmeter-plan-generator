            <hashTree/>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0)写入数据: ${db_name}.t_electmeter: ${__threadNum}" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Update Statement</stringProp>
              <stringProp name="query">${builder}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout">60</stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="预处理数据: ${db_name}.electmeter_${__threadNum}" enabled="true">
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="script">import java.sql.*
import java.io.*
import java.util.List
import java.util.ArrayList

List generateTimestampList() {
  def nextTs = vars.getObject(&quot;last_ts&quot;)
  int lineNum = Integer.parseInt(vars.get(&quot;write_lines&quot;))
  long dataTsStep = Long.parseLong(vars.get(&quot;data_ts_step&quot;))
  def tsList = new ArrayList()
  for(int lineNumIdx = 0; lineNumIdx &lt; lineNum; lineNumIdx++){
    tsList.add(nextTs)
    nextTs += dataTsStep
  }
  vars.putObject(&quot;last_ts&quot;, nextTs)
  return tsList
}

List getSwapedListOrNot() {
  int index = Integer.parseInt(vars.get(&quot;batch_idx&quot;))
  int disorderBatchInterval = Integer.parseInt(vars.get(&quot;disorder_batch_interval&quot;))
  log.debug(&quot;index={}&quot;, index)
  log.debug(&quot;disorderBatchInterval={}&quot;, disorderBatchInterval)
  if (disorderBatchInterval != 0 &amp;&amp; index % disorderBatchInterval == 0) {
	tmpList = generateTimestampList().swap(0, Integer.parseInt(vars.get(&quot;swap_line_idx&quot;)))
	log.debug(&quot;tmpList={}&quot;, tmpList)
    return tmpList
  }
  return generateTimestampList()
}

void generateBatchInsertSQL() {
  def csv_list = vars.getObject(&quot;csv_list&quot;)
  def builder = new StringBuilder()
  def td_builder = new StringBuilder()
  int workshop_id = (Integer.parseInt(&quot;${__threadNum}&quot;) - 1) * 5 + (Integer.parseInt(vars.get(&quot;device_num&quot;)) - 1) % 5 + 1
  builder.append(&quot;insert into ${vars.get(&quot;db_name&quot;)}.t_electmeter (k_timestamp, elect_name,vol_a,cur_a, powerf_a, allenergy_a, pallenergy_a, rallenergy_a, allrenergy1_a, allrenergy2_a, powera_a, powerr_a, powerl_a, vol_b, cur_b, powerf_b, allenergy_b, pallenergy_b, rallenergy_b, allrenergy1_b, allrenergy2_b, powera_b, powerr_b, powerl_b, vol_c, cur_c, powerf_c, allenergy_c, pallenergy_c, rallenergy_c, allrenergy1_c, allrenergy2_c, powera_c, powerr_c, powerl_c, vol_ab, vol_bc, vol_ca, infre, powerf, allpower, pallpower, rallpower, powerr, powerl, allrenergy1, allrenergy2, machine_code, op_group, workshop_id, cnc_number) values &quot;)
