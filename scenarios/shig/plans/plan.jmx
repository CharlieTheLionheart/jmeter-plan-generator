            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="SQL1: assert_sp_act_speed" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Prepared Select Statement</stringProp>
              <stringProp name="query">select k_timestamp, sp_act_speed from db_shig.t_cnc where op_group  = &apos;op_group_${__threadNum}&apos; and machine_code  = &apos;${machine_code}&apos; and k_timestamp &gt; (${begin_timestamp})::timestamptz and k_timestamp &lt; (${end_timestamp})::timestamptz order by k_timestamp desc limit ${page_size} offset ${page_start}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">k_timestamp_sp_act_speed,sp_act_speed_actual</stringProp>
              <stringProp name="resultVariable">sp_act_speed_result_list</stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree>
              <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 预处理程序" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">false</stringProp>
                <stringProp name="script">def pageNo = Integer.parseInt(vars.getObject(&quot;page_no&quot;));
def pageSize = Integer.parseInt(vars.getObject(&quot;page_size&quot;));
vars.putObject(&quot;page_start&quot;, (pageNo - 1)*pageSize);
vars.putObject(&quot;begin_timestamp&quot;, ${__timeShift(,,PT-20M,,)})
vars.putObject(&quot;end_timestamp&quot;, ${__timeShift(,,PT-10M,,)})
vars.putObject(&quot;machine_code&quot;, &quot;1_${__Random(1,${device_rand_end},)}&quot;)</stringProp>
              </JSR223PreProcessor>
              <hashTree/>
              <JSR223Assertion guiclass="TestBeanGUI" testclass="JSR223Assertion" testname="JSR223 断言" enabled="true">
                <stringProp name="scriptLanguage">groovy</stringProp>
                <stringProp name="parameters"></stringProp>
                <stringProp name="filename"></stringProp>
                <stringProp name="cacheKey">true</stringProp>
                <stringProp name="script">import org.apache.jmeter.util.JMeterUtils;

boolean isCycleContains(String expect, String actual) {
    StringBuilder dupStringBuilder
    if (expect.length() &gt; actual.length()) {
        dupStringBuilder = new StringBuilder(expect)
        dupStringBuilder.append(expect)
        return dupStringBuilder.toString().contains(actual)
    } else {
        dupStringBuilder = new StringBuilder(actual)
        dupStringBuilder.append(actual)
        return dupStringBuilder.toString().contains(expect)
    }
}

String spActSpeedExpect = JMeterUtils.getProperty(&quot;sp_act_speed_list_expect&quot;)

List spActSpeedResultList = vars.getObject(&quot;sp_act_speed_result_list&quot;)
StringBuilder spActSpeedBuilder = new StringBuilder()
for (int resultIndex = spActSpeedResultList.size(); resultIndex &gt;= 1; resultIndex--) {
    spActSpeedBuilder.append(vars.get(&quot;sp_act_speed_actual_&quot; + resultIndex))
    if (resultIndex &gt; 1) {
        spActSpeedBuilder.append(&quot;,&quot;)
    }
}
String spActSpeedActual = spActSpeedBuilder.toString()


if (isCycleContains(spActSpeedExpect, spActSpeedActual)) {
    AssertionResult.setFailure(false)
} else {
    AssertionResult.setFailure(true)
    pageStart = vars.get(&quot;page_start&quot;)
    pageSize = vars.get(&quot;page_size&quot;)
    beginTimestamp = vars.get(&quot;begin_timestamp&quot;)
    endTimestamp = vars.get(&quot;end_timestamp&quot;)
    machineCode = vars.get(&quot;machine_code&quot;)
    AssertionResult.setFailureMessage(
        &quot;page_start=&quot; + pageStart + 
        &quot;,\npage_size=&quot; + pageSize + 
        &quot;,\nbegin_timestamp=&quot; + beginTimestamp + 
        &quot;,\nend_timestamp=&quot; + endTimestamp + 
        &quot;,\nmachine_code=&quot; + machineCode + 
        &quot;,\nspActSpeedExpect=&quot; + spActSpeedExpect + 
        &quot;,\nspActSpeedActual=&quot; + spActSpeedActual)
}</stringProp>
              </JSR223Assertion>
              <hashTree/>
            </hashTree>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="commit(SQL1: assert_sp_act_speed)" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Commit</stringProp>
              <stringProp name="query"></stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames"></stringProp>
              <stringProp name="resultVariable"></stringProp>
