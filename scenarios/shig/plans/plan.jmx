                <stringProp name="script">import org.apache.jmeter.util.JMeterUtils;

String lastCncExpect = JMeterUtils.getProperty(&quot;last_cnc_expect&quot;).replaceAll(&quot;&apos;&quot;, &quot;&quot;)

if (vars.get(&quot;k_timestamp_1&quot;) == null) {
    AssertionResult.setFailureMessage(&quot;query result is empty&quot;)
    AssertionResult.setFailure(true)
    return
}

List&lt;String&gt; fieldList = new ArrayList()
fieldList.add(vars.get(&quot;k_timestamp_1&quot;))
