          <CSVDataSet guiclass="TestBeanGUI" testclass="CSVDataSet" testname="加载数据" enabled="true">
            <stringProp name="delimiter">|</stringProp>
            <stringProp name="fileEncoding">UTF-8</stringProp>
            <stringProp name="filename">${sample_data}</stringProp>
            <boolProp name="ignoreFirstLine">false</boolProp>
