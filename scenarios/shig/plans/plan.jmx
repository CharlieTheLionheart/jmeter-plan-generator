vars.put(&quot;q_begin_ts&quot;, dtf.format(monthBegin))
vars.put(&quot;q_end_ts&quot;, dtf.format(monthEnd))

log.debug(&quot;q_begin_ts={}&quot;, vars.get(&quot;q_begin_ts&quot;))
