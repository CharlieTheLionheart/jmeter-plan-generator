              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Select Statement</stringProp>
              <stringProp name="query">select sum(pallpower) as sumpallpower, count(1) as countall from db_shig.t_electmeter t where 1=1 and t.k_timestamp &gt; (${begin_timestamp})::timestamptz and t.k_timestamp &lt; (${end_timestamp})::timestamptz;</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames">sumpallpower,countall</stringProp>
              <stringProp name="resultVariable">result_list</stringProp>
