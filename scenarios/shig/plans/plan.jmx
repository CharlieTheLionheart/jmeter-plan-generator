        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="(2.0.0) 写入厂区元数据" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT INTO ${db_relation_name}.factory VALUES
(1, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(2, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(3, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(4, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(5, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(6, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
(7, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
(8, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
(9, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
