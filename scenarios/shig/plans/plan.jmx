              <stringProp name="query">select max(sp_override), 
       min(sp_override), 
       avg(sp_override), 
       sum(sp_override)
  from 
  db_shig_meta.sub_company s, 
  db_shig.t_cnc c 
 where c.sub_company_id = s.id
   and s.region = &apos;南方大区&apos;
   and c.k_timestamp &gt; &apos;${q_begin_ts}&apos; 
   and c.k_timestamp &lt; &apos;${q_end_ts}&apos;;</stringProp>
              <stringProp name="queryArguments">${machine_code}</stringProp>
