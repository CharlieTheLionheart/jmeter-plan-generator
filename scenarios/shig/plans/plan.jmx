              </elementProp>
            </collectionProp>
          </elementProp>
          <stringProp name="classname">com.kaiwudb.svt.sampler.CommaSplitColSeedGeneratorSampler</stringProp>
        </JavaSampler>
        <hashTree/>
        <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="[Setup] 加载建库建表语句" enabled="true">
          <boolProp name="displayJMeterProperties">false</boolProp>
          <boolProp name="displayJMeterVariables">true</boolProp>
          <boolProp name="displaySystemProperties">false</boolProp>
        </DebugSampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[Setup] JSR223 预处理程序" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">def sql_file=&quot;${seed_conf_path}/${db_name}/create.sql&quot;

def sql_reader = new RandomAccessFile(sql_file, &quot;r&quot;)
def sql_amount = 0;
do {
  line = sql_reader.readLine();
  if (line != null) {
    sql_amount++;
    vars.put(&quot;create_sql_&quot;+sql_amount, line)
  }
} while (line != null);

vars.put(&quot;sql_amount&quot;, sql_amount+&quot;&quot;);</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="[Setup] 建库建表" enabled="true">
          <stringProp name="LoopController.loops">${sql_amount}</stringProp>
        </LoopController>
        <hashTree>
          <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="[Setup] 计数器" enabled="true">
            <stringProp name="CounterConfig.start">1</stringProp>
            <stringProp name="CounterConfig.end">${sql_amount}</stringProp>
            <stringProp name="CounterConfig.incr">1</stringProp>
            <stringProp name="CounterConfig.name">sql_idx</stringProp>
            <stringProp name="CounterConfig.format"></stringProp>
            <boolProp name="CounterConfig.per_user">false</boolProp>
          </CounterConfig>
          <hashTree/>
          <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="[Setup] 执行建库/建表语句" enabled="true">
            <stringProp name="dataSource">default_pool</stringProp>
            <stringProp name="queryType">Update Statement</stringProp>
            <stringProp name="query">${__V(create_sql_${sql_idx},)}</stringProp>
            <stringProp name="queryArguments"></stringProp>
            <stringProp name="queryArgumentsTypes"></stringProp>
            <stringProp name="variableNames"></stringProp>
            <stringProp name="resultVariable"></stringProp>
            <stringProp name="queryTimeout"></stringProp>
            <stringProp name="resultSetMaxRows"></stringProp>
            <stringProp name="resultSetHandler">Store as String</stringProp>
          </JDBCSampler>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="[Setup] kafka socket不为空" enabled="true">
          <stringProp name="IfController.condition">${__groovy(!&quot;${kafka_socket}&quot;.isEmpty())}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">true</boolProp>
        </IfController>
        <hashTree>
          <DebugSampler guiclass="TestBeanGUI" testclass="DebugSampler" testname="[Setup] 加载创建实时订阅pipe语句" enabled="true">
            <boolProp name="displayJMeterProperties">false</boolProp>
            <boolProp name="displayJMeterVariables">true</boolProp>
            <boolProp name="displaySystemProperties">false</boolProp>
          </DebugSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="[Setup] JSR223 预处理程序" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def pipe_sql_file=&quot;${seed_conf_path}/${db_name}/create_pipe.sql&quot;

def pipe_sql_reader = new RandomAccessFile(pipe_sql_file, &quot;r&quot;)
def pipe_sql_amount = 0;
def kafka_socket_pattern = &quot;KAFKA_SOCKET&quot;;
do {
  line = pipe_sql_reader.readLine();
  if (line != null) {
    pipe_sql_amount++;
    vars.put(&quot;pipe_sql_&quot;+pipe_sql_amount, line.replaceAll(kafka_socket_pattern, &quot;${kafka_socket}&quot;))
  }
} while (line != null);

vars.put(&quot;pipe_sql_amount&quot;, pipe_sql_amount+&quot;&quot;);</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
          <LoopController guiclass="LoopControlPanel" testclass="LoopController" testname="[Setup] 创建实时订阅pipe" enabled="true">
            <stringProp name="LoopController.loops">${pipe_sql_amount}</stringProp>
          </LoopController>
          <hashTree>
            <CounterConfig guiclass="CounterConfigGui" testclass="CounterConfig" testname="[Setup] 计数器" enabled="true">
              <stringProp name="CounterConfig.start">1</stringProp>
              <stringProp name="CounterConfig.end">${pipe_sql_amount}</stringProp>
              <stringProp name="CounterConfig.incr">1</stringProp>
              <stringProp name="CounterConfig.name">pipe_sql_idx</stringProp>
              <stringProp name="CounterConfig.format"></stringProp>
              <boolProp name="CounterConfig.per_user">false</boolProp>
            </CounterConfig>
            <hashTree/>
            <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="[Setup] 执行建库/建表语句" enabled="true">
              <stringProp name="dataSource">default_pool</stringProp>
              <stringProp name="queryType">Update Statement</stringProp>
              <stringProp name="query">${__V(pipe_sql_${pipe_sql_idx},)}</stringProp>
              <stringProp name="queryArguments"></stringProp>
              <stringProp name="queryArgumentsTypes"></stringProp>
              <stringProp name="variableNames"></stringProp>
              <stringProp name="resultVariable"></stringProp>
              <stringProp name="queryTimeout"></stringProp>
              <stringProp name="resultSetMaxRows"></stringProp>
              <stringProp name="resultSetHandler">Store as String</stringProp>
            </JDBCSampler>
            <hashTree/>
          </hashTree>
        </hashTree>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="[Setup] 写入分公司元数据" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT INTO ${db_relation_name}.sub_company VALUES
(1, &apos;济南分公司&apos;, &apos;北方大区&apos;),
(2, &apos;沈阳分公司&apos;, &apos;北方大区&apos;),
(3, &apos;武汉分公司&apos;, &apos;南方大区&apos;),
(4, &apos;柳州分公司&apos;, &apos;南方大区&apos;) ON CONFLICT (id) DO NOTHING;</stringProp>
          <stringProp name="queryArguments"></stringProp>
          <stringProp name="queryArgumentsTypes"></stringProp>
          <stringProp name="variableNames"></stringProp>
          <stringProp name="resultVariable"></stringProp>
          <stringProp name="queryTimeout">600</stringProp>
          <stringProp name="resultSetMaxRows"></stringProp>
          <stringProp name="resultSetHandler">Store as String</stringProp>
        </JDBCSampler>
        <hashTree/>
        <JDBCSampler guiclass="TestBeanGUI" testclass="JDBCSampler" testname="[Setup] 写入厂区元数据" enabled="true">
          <stringProp name="dataSource">default_pool</stringProp>
          <stringProp name="queryType">Update Statement</stringProp>
          <stringProp name="query">INSERT INTO ${db_relation_name}.factory VALUES
(1, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(2, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(3, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(4, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(5, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 1),
(6, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
(7, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
(8, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
(9, &apos;${__RandomString(${__Random(1,5,)},${random_string_charset},)}FAC&apos;, 2),
